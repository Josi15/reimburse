APP_NAME=FundBack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Jika memakai Laravel Herd, jalankan `herd link <nama>` lalu set:
#   APP_URL=http://<nama>.test
#   SANCTUM_STATEFUL_DOMAINS=<nama>.test,localhost,127.0.0.1
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reimbursement
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (dipakai fitur "Lupa Password" & notifikasi).
#
# MAIL_MAILER=log  -> email TIDAK dikirim, isinya (termasuk tautan reset)
#                     ditulis ke storage/logs/laravel.log. Default untuk dev.
# MAIL_MAILER=smtp -> pengiriman sungguhan, isi host/port/kredensial di bawah.
#
#   Gmail    : MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=null
#              MAIL_USERNAME = alamat Gmail lengkap
#              MAIL_PASSWORD = App Password 16 karakter tanpa spasi dari
#              https://myaccount.google.com/apppasswords (perlu 2FA aktif),
#              BUKAN password akun. MAIL_FROM_ADDRESS harus alamat Gmail yang
#              sama, kalau tidak Gmail menimpanya. Jika 587 diblokir jaringan:
#              MAIL_PORT=465 + MAIL_SCHEME=smtps.
#   Mailpit  : MAIL_HOST=127.0.0.1  MAIL_PORT=1025  (tanpa user/password)
#   Mailtrap : MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
#
# Verifikasi: php artisan config:clear && php artisan mail:test <email-tujuan>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@fundback.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
