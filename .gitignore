/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
# Semua varian .env diabaikan, bukan cuma tiga nama yang kebetulan terpikirkan.
# Salinan sementara (.env.bak, .env.local, "env - Copy") lahir tiap kali orang
# mengutak-atik konfigurasi, dan satu "git add -A" sudah cukup untuk mengirim
# kredensial database dan SMTP ke repo. Pengecualiannya hanya .env.example yang
# memang harus ikut versi karena isinya cuma contoh tanpa nilai rahasia.
.env
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
# IDE helper (dibuat ulang: php artisan ide-helper:generate|meta|models --nowrite)
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php
/.fleet
/.idea
/.nova
/.vscode
/.zed
